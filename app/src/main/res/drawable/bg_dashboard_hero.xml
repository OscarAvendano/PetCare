<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Card Base -->
    <item>
        <shape>
            <solid android:color="#FFFFFF"/>
            <stroke
                android:width="1dp"
                android:color="#E6E8F5"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <!-- Left Accent Stripe -->
    <item
        android:left="0dp"
        android:top="16dp"
        android:bottom="16dp"
        android:width="4dp">
        <shape>
            <solid android:color="#E59A72"/>
            <corners
                android:topRightRadius="4dp"
                android:bottomRightRadius="4dp"/>
        </shape>
    </item>
</layer-list>
