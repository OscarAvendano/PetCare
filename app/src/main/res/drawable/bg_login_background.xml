<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <color android:color="@color/pc_background"/>
    </item>

    <item
        android:gravity="top|left"
        android:width="280dp"
        android:height="280dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="180dp"
                android:centerColor="#30BEBEFF"
                android:endColor="#00BEBEFF"/>
        </shape>
    </item>

    <item
        android:gravity="top|right"
        android:width="240dp"
        android:height="240dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="160dp"
                android:centerColor="#25C2C1FB"
                android:endColor="#00C2C1FB"/>
        </shape>
    </item>

</layer-list>
