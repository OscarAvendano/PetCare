<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_background">

    <!-- CONTENIDO PRINCIPAL -->

    <ScrollView
        android:id="@+id/scrollLogin"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/footerLogin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp">

            <!-- CABECERA -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_input"
                    android:src="@android:drawable/ic_media_previous"
                    android:contentDescription="Volver atrás"
                    android:padding="11dp"
                    android:tint="@color/pc_navy"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:translationX="-20dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_petcare"
                        android:contentDescription="Logo PetCare"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="5dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PetCare"
                            android:textColor="@color/pc_navy"
                            android:textSize="15sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BIENESTAR ANIMAL"
                            android:textColor="@color/pc_secondary"
                            android:textSize="7sp"
                            android:letterSpacing="0.12"/>

                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- BIENVENIDA -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_badge"
                    android:gravity="center"
                    android:paddingStart="11dp"
                    android:paddingEnd="11dp"
                    android:text="•  Acceso Clínico &amp; Hogar"
                    android:textColor="@color/pc_navy"
                    android:textSize="11sp"
                    android:fontFamily="sans"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Bienvenido de nuevo"
                    android:textColor="@color/pc_navy"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:fontFamily="sans"
                    android:letterSpacing="-0.025"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Ingresa tus credenciales para cuidar de tus mascotas."
                    android:textColor="@color/pc_text_secondary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp"/>

            </LinearLayout>

            <!-- FORMULARIO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp">

                <!-- CORREO -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Correo electrónico"
                    android:textColor="@color/pc_navy"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:elevation="1dp">

                    <TextView
                        android:layout_width="25dp"
                        android:layout_height="wrap_content"
                        android:text="✉"
                        android:textSize="19sp"
                        android:textColor="@color/pc_secondary"/>

                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="ejemplo@correo.com"
                        android:inputType="textEmailAddress"
                        android:singleLine="true"
                        android:paddingStart="10dp"
                        android:textColor="@color/pc_text"
                        android:textColorHint="@color/pc_hint"
                        android:textSize="13sp"/>

                </LinearLayout>

                <!-- CONTRASEÑA -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:text="Contraseña"
                    android:textColor="@color/pc_navy"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp"
                    android:elevation="1dp">

                    <TextView
                        android:layout_width="25dp"
                        android:layout_height="wrap_content"
                        android:text="●"
                        android:textColor="@color/pc_secondary"
                        android:textSize="16sp"/>

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Contraseña"
                        android:inputType="textPassword"
                        android:singleLine="true"
                        android:paddingStart="10dp"
                        android:textColor="@color/pc_text"
                        android:textColorHint="@color/pc_hint"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/btnTogglePassword"
                        android:layout_width="35dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="◉"
                        android:textColor="@color/pc_secondary"
                        android:textSize="19sp"
                        android:clickable="true"
                        android:focusable="true"/>

                </LinearLayout>

                <!-- RECORDAR / RECUPERAR -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/cbRememberMe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/pc_navy"
                        android:padding="0dp"
                        android:text="Recordarme"
                        android:textColor="@color/pc_text_secondary"
                        android:textSize="12sp"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"/>

                    <TextView
                        android:id="@+id/tvForgotPassword"
                        android:layout_width="133dp"
                        android:layout_height="27dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="¿Olvidaste tu contraseña?"
                        android:textColor="@color/pc_secondary"
                        android:textSize="11sp" />

                </LinearLayout>

                <!-- MENSAJES -->

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="4dp"
                    android:textColor="@color/pc_error"
                    android:textSize="11sp"
                    android:visibility="gone"/>

                <!-- BOTÓN PRINCIPAL -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button_primary"
                    android:elevation="5dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnLogin"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:text="Iniciar sesión     ➜"
                        android:textAllCaps="false"
                        android:textColor="@color/pc_surface"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:stateListAnimator="@null"/>

                </LinearLayout>

            </LinearLayout>

            <!-- SEPARADOR -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#40C8C5D0"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:text="O CONTINÚA CON"
                    android:textColor="@color/pc_text_secondary"
                    android:textSize="10sp"
                    android:letterSpacing="0.06"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#40C8C5D0"/>

            </LinearLayout>

            <!-- GOOGLE -->

            <Button
                android:id="@+id/btnGoogle"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input"
                android:backgroundTint="@null"
                android:elevation="1dp"
                android:text="G     Google"
                android:textAllCaps="false"
                android:textColor="@color/pc_navy"
                android:textSize="13sp"
                android:textStyle="bold"
                android:stateListAnimator="@null"/>

        </LinearLayout>

    </ScrollView>

    <!-- PIE FIJO -->

    <LinearLayout
        android:id="@+id/footerLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Aún no tienes cuenta?"
                android:textColor="@color/pc_text_secondary"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tvRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="Regístrate aquí"
                android:textColor="@color/pc_coral"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
