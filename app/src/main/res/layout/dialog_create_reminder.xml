<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/create_reminder_dialog_title"
        android:textColor="@color/pc_navy"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- TÍTULO DEL RECORDATORIO -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/reminder_title_label"
        android:textColor="@color/pc_navy"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:autofillHints="name"
        android:background="@drawable/bg_input"
        android:hint="@string/reminder_title_placeholder"
        android:inputType="text"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/pc_navy"
        android:textColorHint="@color/pc_hint"
        android:textSize="14sp" />

    <!-- TIPO DE EVENTO -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/type_label"
        android:textColor="@color/pc_navy"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spDialogType"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_input"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

    <!-- FECHA Y HORA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/date_label_req"
                android:textColor="@color/pc_navy"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etDialogDate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input"
                android:clickable="true"
                android:focusable="false"
                android:hint="@string/birthdate_placeholder"
                android:inputType="date"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/pc_navy"
                android:textColorHint="@color/pc_hint"
                android:textSize="13sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/time_label"
                android:textColor="@color/pc_navy"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etDialogTime"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input"
                android:clickable="true"
                android:focusable="false"
                android:hint="10:30 AM"
                android:inputType="time"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/pc_navy"
                android:textColorHint="@color/pc_hint"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- MASCOTA ASOCIADA -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/pet_label"
        android:textColor="@color/pc_navy"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spDialogPet"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_input"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

    <!-- LUGAR / CLÍNICA -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/location_label"
        android:textColor="@color/pc_navy"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etDialogLocation"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_input"
        android:hint="@string/location_placeholder"
        android:inputType="text"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/pc_navy"
        android:textColorHint="@color/pc_hint"
        android:textSize="14sp" />

    <!-- VETERINARIO / NOTAS -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/doctor_label"
        android:textColor="@color/pc_navy"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etDialogDoctor"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_input"
        android:hint="@string/doctor_placeholder"
        android:inputType="text"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/pc_navy"
        android:textColorHint="@color/pc_hint"
        android:textSize="14sp" />

    <!-- BOTÓN GUARDAR -->
    <Button
        android:id="@+id/btnSaveDialog"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_button_primary"
        android:text="@string/save_reminder_dialog_btn"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
